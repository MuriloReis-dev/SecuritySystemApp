<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SecuritySystemApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SecuritySystemApp"
    xmlns:views="clr-namespace:SecuritySystemApp.Views"
    Title="SecuritySystemApp">

    <Shell.ToolbarItems>
        <ToolbarItem IconImageSource="homeicon.png" />
    </Shell.ToolbarItems>

    <ShellContent
        Title="MainPage"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="HomePage"
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePageReset" />

</Shell>
