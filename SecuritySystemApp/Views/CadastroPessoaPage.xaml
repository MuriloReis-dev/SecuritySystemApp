<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SecuritySystemApp.Views.CadastroPessoaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SecuritySystemApp.ViewModels"
    Title="Cadastro de Pessoa">

    <ContentPage.BindingContext>
        <vm:CadastroPessoaViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label FontAttributes="Bold" Text="Nome" />
            <Entry Placeholder="Digite o nome" Text="{Binding Nome}" />

            <Label FontAttributes="Bold" Text="Senha (5 dígitos de 1 a 9)" />
            <Entry
                Keyboard="Numeric"
                MaxLength="5"
                Placeholder="Ex: 12345"
                Text="{Binding Senha}" />

            <Label FontAttributes="Bold" Text="Portas" />
            <Border
                Padding="8"
                Background="#f5f5f5"
                Stroke="#E0A100"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="2">
                <CollectionView
                    HeightRequest="220"
                    ItemsSource="{Binding Portas}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout
                                Padding="8"
                                Spacing="12"
                                VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsSelecionada}" VerticalOptions="Center" />
                                <Label Text="{Binding Nome}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Button
                BackgroundColor="#4CAF50"
                Command="{Binding CadastrarCommand}"
                CornerRadius="8"
                HeightRequest="48"
                Text="Salvar"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>