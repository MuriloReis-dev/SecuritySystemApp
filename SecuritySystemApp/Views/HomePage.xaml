<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:SecuritySystemApp.Components"
             x:Class="SecuritySystemApp.Views.HomePage"
             Title="Seus Alarmes">
             
    <Grid RowDefinitions="Auto, *, Auto">
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto, Auto, *">
                <Label Text="Gráfico geral"
                       FontSize="28"
                       FontFamily="Cursive"
                       HorizontalOptions="Center"
                       TextColor="Black"
                       Grid.Row="0"/>
                <!-- Gráfico falso precisamos do Banco para fazer o de verdade -->
                <Border Stroke="#E0A100" StrokeShape="RoundRectangle 20" Margin="10" Padding="10" Grid.Row="1">
                    <BoxView Color="Gray" HeightRequest="150" CornerRadius="20"/>
                </Border>
                <CollectionView x:Name="AlarmesList" Grid.Row="2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="3"
                                Padding="10"
                                MaximumHeightRequest="80"
                                VerticalOptions="Fill"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Ligado}" Value="True">
                                        <!-- Definir style para ligado = true -->
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Ligado}" Value="False">
                                        <!-- Definir style para ligado = false -->
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Aspect="AspectFit">
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image" Binding="{Binding Ligado}" Value="True">
                                                <Setter Property="Source" Value="alarme_on.png"></Setter> <!-- Imagem para ligado = true -->
                                            </DataTrigger>
                                            <DataTrigger TargetType="Image" Binding="{Binding Ligado}" Value="False">
                                                <Setter Property="Source" Value="alarme_off.png"></Setter> <!-- Imagem para ligado = false -->
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <VerticalStackLayout Padding="10" Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" FontSize="20"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ScrollView>
        <components:BottomTabsView Grid.Row="2" />
    </Grid>
</ContentPage>
