<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:SecuritySystemApp.Components"
             x:Class="SecuritySystemApp.Views.HomePage"
             Title="Seus Alarmes">
             
    <Grid ColumnDefinitions="*" RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!--  Título  -->
                <Label
                    FontFamily="Cursive"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Gráfico geral" />

                <!--  Gráfico falso (aqui você usaria uma lib ou desenharia com graphics API)  -->
                <Border
                    Padding="10"
                    Stroke="#E0A100"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="2">
                    <BoxView HeightRequest="150" Color="Gray" />
                </Border>
                <!--  Lista de alarmes  -->
                <Border
                    Margin="10"
                    Padding="10"
                    Background="#a09c9c"
                    HorizontalOptions="Fill"
                    Stroke="#d8d8d8"
                    StrokeThickness="3"
                    VerticalOptions="Start">
                    <CollectionView
                        HeightRequest="300"
                        x:Name="AlarmesList"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Always">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="5"
                                    Padding="10"
                                    StrokeShape="RoundRectangle 10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Ligado}" Value="True">
                                            <Setter Property="Background" Value="#a8e6a1" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Ligado}" Value="False">
                                            <Setter Property="Background" Value="#f7a8a8" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout Spacing="10">
                                        <Image WidthRequest="30">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding Ligado}" Value="True">
                                                    <Setter Property="Source" Value="alarme_green_full.png" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Image" Binding="{Binding Ligado}" Value="False">
                                                    <Setter Property="Source" Value="alarme_red_full.png" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Id}" TextColor="Black" />
                                            <Label Text="{Binding Nome}" TextColor="Black" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <components:BottomTabsView CurrentPage="HomePage" Grid.Row="1" />
    </Grid>
</ContentPage>
