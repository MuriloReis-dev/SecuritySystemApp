<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SecuritySystemApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="Login">

    <ScrollView HorizontalOptions="Fill">
        <Grid ColumnDefinitions="*" VerticalOptions="Center">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                Padding="10"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="2"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Margin="16"
                Grid.Column="0">
                <VerticalStackLayout HorizontalOptions="Fill" Padding="20" Spacing="15">
                    <Label Text="Login"
                        FontSize="35"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="White" />

                    <!-- Campo Email -->
                    <Label Text="Email" FontSize="14" HorizontalOptions="Start" TextColor="White" />
                    <Entry
                        x:Name="EmailEntry"
                        Placeholder="Digite seu Email"
                        Keyboard="Email"
                        HorizontalOptions="Fill"
                        PlaceholderColor="{AppThemeBinding Light='White', Dark={StaticResource Gray200}}" />
                    <Label x:Name="EmailErrorLabel" Text="Email inválido" TextColor="Red" IsVisible="False" FontSize="12" HorizontalOptions="Center"/>

                    <!-- Campo Senha -->
                    <Label Text="Senha" FontSize="14" HorizontalOptions="Start" TextColor="White" />
                    <Entry
                        x:Name="SenhaEntry"
                        Placeholder="Digite sua Senha"
                        IsPassword="True"
                        HorizontalOptions="Fill"
                        PlaceholderColor="{AppThemeBinding Light='White', Dark={StaticResource Gray200}}" />
                    <Label x:Name="SenhaErrorLabel" Text="A senha precisa ter pelo menos 8 dígitos" TextColor="Red" IsVisible="False" FontSize="12" HorizontalOptions="Center"/>
                    
                    <!-- Captcha simples -->
                    <Label Text="Não sou um robô" FontSize="14" HorizontalOptions="Center" TextColor="White" />
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="3 + 4 =" FontSize="14" VerticalOptions="Center" TextColor="White" />
                        <Entry
                            x:Name="CaptchaEntry"
                            Placeholder="Digite a resposta"
                            Keyboard="Numeric"
                            HorizontalOptions="Fill"
                            PlaceholderColor="{AppThemeBinding Light='White', Dark={StaticResource Gray200}}" />
                    </HorizontalStackLayout>
                    <Label x:Name="CaptchaErrorLabel" Text="Captcha incorreto" TextColor="Red" IsVisible="False" FontSize="12" HorizontalOptions="Center"/>
                    
                    <!-- Cadastro Link -->
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="Não tem uma conta?" FontSize="14" TextColor="White" VerticalOptions="Center" />
                        <Button Text="Cadastre-se"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                TextColor="LightBlue"
                                Clicked="OnCadastroClicked" />
                    </HorizontalStackLayout>

                    <!-- Submit -->
                    <Grid ColumnDefinitions="*" ColumnSpacing="0" HorizontalOptions="End">
                        <Button Text="Enviar"
                                BackgroundColor="LightBlue"
                                Clicked="OnEnviarClicked"
                                TextColor="Black"
                                Grid.Column="0"
                                HorizontalOptions="Fill" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
